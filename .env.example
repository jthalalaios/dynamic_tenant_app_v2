APP_NAME=nodejs-react-app

# --- Database (PostgreSQL) ------------------------------------------------------
POSTGRES_DB_HOST=postgres
POSTGRES_DB_DATABASE=nodejs-react-app
POSTGRES_DB_USERNAME=nodejs-react-app-user
POSTGRES_DB_PASSWORD=change-me
# Host port (5439, so it never collides with the Laravel stack's 5438)
POSTGRES_DB_HOST_PORT=5439
POSTGRES_DB_PORT=5432

# --- Redis (ACL cache, rate limits, realtime fan-out) ----------------------------
REDIS_HOST_PORT=6380
REDIS_PORT=6379
REDIS_HOST=redis-alpine

# --- nginx (API + websockets) ----------------------------------------------------
HTTP_HOST_PORT=8081
HTTP_PORT=80
APP_URL=http://localhost:8081

# --- Frontend (multi-theme React SPA) --------------------------------------------
VITE_API_URL=http://localhost:8081/api
VITE_PORT=5273
FRONTEND_URL=http://localhost:5273

# --- Themes / separated apps -----------------------------------------------------
# Standalone frontends (docker compose --profile standalone up); emailed links
# for clinic / market accounts open these when set.
# Only set these while the standalone apps run: otherwise emailed links would open
# ports nobody listens on. Unset = the multi app (FRONTEND_URL), which serves every theme.
#FRONTEND_URL_DOCTOR=http://localhost:5274
#FRONTEND_URL_MARKETPLACE=http://localhost:5275
# Backend: themes served, empty = all. Frontend: themes offered by the multi app.
TENANCY_THEMES=
VITE_APP_THEMES=
AUTH_VERIFY_EMAIL=true

# --- Realtime / live chat (Socket.IO) ---------------------------------------------
# Where browsers open the websocket: nginx proxies /socket.io/* on HTTP_HOST_PORT
REALTIME_PUBLIC_URL=http://localhost:8081
# Hosts allowed to connect, comma separated (e.g. "localhost,app.example.com"); * = any
REALTIME_ALLOWED_ORIGINS=*

# --- Mail (local catcher) ------------------------------------------------------
# Mailpit web inbox: every email the API sends shows up here
MAILPIT_UI_PORT=8025
