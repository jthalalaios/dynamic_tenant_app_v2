# Docker only reads ignore files from the build-context root or from
# "<Dockerfile>.dockerignore", so this file must live next to the Dockerfile
# under this name. The build context is the repository root, so every path
# below is relative to it.

# Not needed for the API image
react-frontend
configuration/postgres
configuration/nginx
configuration/frontend_conf
.env

# Installed by the deps stage; host copies would be merged over it
nodejs-app/node_modules

# Runtime & sensitive files
nodejs-app/.env
nodejs-app/coverage
nodejs-app/logs

# OS files
**/.DS_Store
