{
  "name": "nodejs-app",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-theme clinic & shop API (Node.js 24, Fastify, Kysely, Socket.IO)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch-path=src src/server.ts",
    "start": "node src/server.ts",
    "realtime": "node src/realtime.ts",
    "cli": "node src/cli.ts",
    "migrate": "node src/cli.ts migrate",
    "seed": "node src/cli.ts db:seed",
    "type-check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "ioredis": "^5.11.1",
    "jose": "^6.2.17",
    "kysely": "^0.29.9",
    "luxon": "^3.7.2",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "socket.io-client": "^4.8.4",
    "typescript": "~6.0.3"
  }
}
