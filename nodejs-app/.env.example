APP_NAME=Workspace
# local | production (local enables the /dev/mail email previews)
APP_ENV=local
# Signs access tokens and email verification links; generate with: openssl rand -base64 32
APP_KEY=
APP_URL=http://localhost:3000
APP_LOCALE=en
LOG_LEVEL=info

PORT=3000
REALTIME_PORT=6001

# Docker sets every DB_* / REDIS_* value; these are for running outside Docker
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nodejs-react-app
DB_USERNAME=postgres
DB_PASSWORD=

# redis | memory (memory = single process only, no Redis needed)
CACHE_STORE=memory
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# "redis" enables the live chat's realtime events (docker-compose sets it); log | null otherwise
BROADCAST_CONNECTION=log
# Hosts allowed to open a websocket, comma separated; * = any
REALTIME_ALLOWED_ORIGINS=*

BCRYPT_ROUNDS=12

# smtp | log | array. Docker default: the Mailpit catcher (inbox at http://localhost:8025);
# replace host / port / credentials with a real SMTP server to reach real inboxes.
MAIL_MAILER=smtp
# smtp (STARTTLS when offered) | smtps (implicit TLS, usually port 465)
MAIL_SCHEME=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Workspace"

# Frontend(s). FRONTEND_URL is the multi-theme SPA; the per-theme URLs are
# optional standalone frontends. Emailed links use the account's theme URL.
FRONTEND_URL=http://localhost:5273
#FRONTEND_URL_DOCTOR=http://localhost:5274
#FRONTEND_URL_MARKETPLACE=http://localhost:5275
# Themes (tenant types) this backend serves, empty = all. e.g. TENANCY_THEMES=doctor
TENANCY_THEMES=
# Lock app features until users confirm their email
AUTH_VERIFY_EMAIL=true
AUTH_VERIFICATION_TTL_MINUTES=1440
AUTH_TOKEN_TTL_MINUTES=720
PRESENCE_TIMEOUT_MINUTES=5
